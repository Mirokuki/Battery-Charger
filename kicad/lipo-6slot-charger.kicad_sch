		(title "6-Slot 1S LiPo/LiHV Smart USB-C PD Charger (ESP32-C3 BLE + BQ25188 + OLED)")
		(date "2026-11-06")
		(rev "1.0")
		(company "Antigravity Open Hardware")
	)
	(lib_symbols)
	(text "6-SLOT 1S LiPo / LiHV SMART USB-C PD BATTERY CHARGER\n- Input: USB-C PD 9V @ 2.5A (22.5W) optimized for Samsung EP-T2510 via AP33771C\n- Buck Stage: TI TPS565242DRLR (9V -> 4.80V @ 5A)\n- Controller: ESP32-C3-WROOM-02 (BLE 5.0 Android App + Optional 0.96\" I2C OLED)\n- Channels: 8x Independent TI BQ25188 via TCA9548A I2C Mux + CD74HC4051 Voltage Sense"
